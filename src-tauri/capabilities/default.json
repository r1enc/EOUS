{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the EOUS desktop window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "allow-get-provider-credential",
    "allow-set-provider-credential",
    "allow-remove-provider-credential",
    "allow-set-web-search-credential",
    "allow-remove-web-search-credential",
    "allow-get-web-search-credential-status",
    "allow-search-web"
  ]
}
