{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EOUS",
  "version": "0.1.0",
  "identifier": "com.r1enc.eous",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EOUS",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "r1enc",
    "shortDescription": "EOUS desktop application",
    "icon": ["icons/icon.ico"],
    "resources": ["../resources/*"]
  }
}